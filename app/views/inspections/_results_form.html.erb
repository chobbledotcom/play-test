<%# locals: (inspection:) %>
<%
  has_incomplete_fields = inspection.incomplete_fields.any?
  submit_key = has_incomplete_fields ? "submit_continue" : "submit"
%>
<%= render 'chobble_forms/form_context',
  model: inspection,
  i18n_base: 'forms.results',
  submit_key: submit_key,
  excluded_prefill_fields: [:passed] do |form| %>
  <%= hidden_field_tag :tab, 'results' %>
  <%= render 'chobble_forms/fieldset', legend_key: 'comments' do %>
    <% comment_items = inspection.comment_items %>
    <% if comment_items.any? %>
      <ul>
        <% comment_items.each do |item| %>
          <li>
            <strong><%= item[:label] %>:</strong>
            <%= item[:value] %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p><em><%= t("forms.results.messages.no_comments") %></em></p>
    <% end %>
  <% end %>

  <%= render 'chobble_forms/fieldset', legend_key: 'inspection_results' do %>
    <%= render 'chobble_forms/pass_fail', field: :passed %>
    <%= render 'chobble_forms/text_area', field: :risk_assessment, rows: 8 %>
  <% end %>

  <%= render 'chobble_forms/fieldset', legend_key: 'photos' do %>
    <%= turbo_frame_tag "inspection_photo_1_field" do %>
      <%= render 'chobble_forms/file_field', field: :photo_1 %>
    <% end %>

    <%= turbo_frame_tag "inspection_photo_2_field" do %>
      <%= render 'chobble_forms/file_field', field: :photo_2 %>
    <% end %>

    <%= turbo_frame_tag "inspection_photo_3_field" do %>
      <%= render 'chobble_forms/file_field', field: :photo_3 %>
    <% end %>
  <% end %>
<% end %>
