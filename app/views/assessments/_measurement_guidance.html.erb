<% comparisons = AssessmentGuidance.new(assessment).comparisons %>
<% if assessment.inspection.current_checklist? && (comparisons.any? || assessment.is_a?(Assessments::AnchorageAssessment) && assessment.current_bungee?) %>
  <aside aria-label="<%= t('assessment_guidance.title') %>">
    <h3><%= t('assessment_guidance.title') %></h3>
    <p><%= t('assessment_guidance.advisory') %></p>
    <% if comparisons.any? %>
      <ul>
        <% comparisons.each do |entry| %>
          <li>
            <strong><%= measurement_guidance_text(assessment, entry) %></strong>
            <p><%= t(entry.fetch(:context), scope: 'assessment_guidance.rules',
              reference: entry.fetch(:reference)) %></p>
          </li>
        <% end %>
      </ul>
    <% end %>
    <% if assessment.is_a?(Assessments::AnchorageAssessment) && assessment.current_bungee? %>
      <p><%= t('assessment_guidance.bungee_anchors.source') %></p>
      <% if assessment.bungee_side_area.nil? %>
        <p><%= t('assessment_guidance.bungee_anchors.missing') %></p>
      <% else %>
        <p><%= t('assessment_guidance.bungee_anchors.result',
          area: number_with_precision(assessment.bungee_side_area,
            precision: 4, strip_insignificant_zeros: true),
          per_side: assessment.required_anchors_per_side,
          total: assessment.required_anchors) %></p>
        <% if assessment.num_low_anchors.nil? || assessment.num_high_anchors.nil? %>
          <p><%= t('assessment_guidance.bungee_anchors.missing_counts') %></p>
        <% else %>
          <p><%= t('assessment_guidance.bungee_anchors.comparison',
            actual: assessment.total_anchors,
            status: t(assessment.meets_anchor_requirements? ? 'within' : 'outside',
              scope: 'assessment_guidance.status')) %></p>
        <% end %>
      <% end %>
    <% end %>
  </aside>
<% end %>
