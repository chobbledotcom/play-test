#!/usr/bin/env ruby
# typed: false

# CLI wrapper for code standards checking - used by Claude Code hooks

require "bundler/setup"
require "rails"
require_relative "../config/environment"

checker = CodeStandardsChecker.new

if ARGV.empty?
  file_paths = Dir["app/**/*.rb", "lib/**/*.rb"]

  if file_paths.empty?
    abort "No Ruby files found in app, lib, or spec directories"
  end

  violations = checker.check_multiple_files(file_paths)

  if violations.empty?
    puts "✅ All files meet code standards"
    exit 0
  else
    puts checker.format_violations(violations, show_summary: true)
    exit 1
  end
else
  file_path = ARGV[0]

  unless File.exist?(file_path)
    abort "Error: File '#{file_path}' does not exist"
  end

  unless file_path.end_with?(".rb")
    puts "Skipping non-Ruby file: #{file_path}"
    exit 0
  end

  violations = checker.check_file(file_path)

  if violations.empty?
    puts "✅ #{file_path} meets code standards"
    exit 0
  else
    puts "❌ Code standards violations in #{file_path}:"
    puts checker.format_violations(violations, show_summary: false)
    exit 1
  end
end
