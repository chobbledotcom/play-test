#!/usr/bin/env bash
# Opt in to shared-cache in-memory SQLite; browser threads can hit table locks

echo "🧠 Running tests with in-memory database..."
echo "Parallel processes are isolated, but shared-cache connections can lock."
echo "Use the default per-process WAL database for browser tests instead."
echo ""

# Set environment variable and run bin/test with all arguments passed through
IN_MEMORY_DB=true bin/test "$@"
