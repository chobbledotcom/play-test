#!/usr/bin/env python3
"""
grade-code — grade this repo's source and spec files against the house coding
rules in CLAUDE.md using Jev (TypeSafe System One) via the OpenCode zen API.

Every check is a judgement call, not a grep: one Jev systemone call per file,
one question per check, all questions for that file asked in a single call.
The script carries no mechanical checks — the repo already runs those
(CodeStandardsChecker, standardrb, the custom cops, bin/lint). What is left is
the taste: idiomatic Rails, small single-purpose methods, short comments that
explain WHY and carry no history notes, plain technical English, no dead code
or defensive fallbacks, I18n for every user-facing string, semantic HTML, and
specs that are not tautological and read as a clear story.

Targets are files or directories; the default is the whole of app, spec and
lib. Files are graded one at a time.

Usage:
    ./bin/grade-code                                    # app, spec, lib
    ./bin/grade-code app/models spec/features           # chosen dirs
    ./bin/grade-code app/models/inspection.rb           # full single-file report
    ./bin/grade-code --kinds model,controller,service   # only these kinds
    ./bin/grade-code --limit 20                         # first 20 discovered
    ./bin/grade-code spec --workers 6                   # parallel (default 1)
    ./bin/grade-code --csv grades.csv --json
    ./bin/grade-code --list-checks                      # print the rubric

The Jev API key is read from OPENCODE_API_KEY, then /run/secrets/opencode_api_key,
then a .env file in the repo root. Batch mode always exits 0 (it is a report);
single-file mode exits 2 when the file could not be graded.
"""

import argparse
import csv
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from collections import Counter, OrderedDict
from concurrent.futures import ThreadPoolExecutor, as_completed

ZEN_SYSTEMONE_URL = "https://opencode.ai/zen/v1/systemone"
DEFAULT_MODEL = "jev-1.13"
DEFAULT_KEY_FILE = "/run/secrets/opencode_api_key"

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DEFAULT_TARGETS = ["app", "spec", "lib"]

MAX_SOURCE_CHARS = 60000
GRADABLE_EXTS = (".rb", ".erb", ".js")
SKIP_DIR_NAMES = {
    ".bundle", ".git", "coverage", "gems", "log", "node_modules",
    "public", "sorbet", "spencers_app", "storage", "tmp", "vendor",
}
SKIP_PATH_PREFIXES = ("app/assets/",)
# third-party code, not house code: the upstream highlight.js distribution
VENDORED_FILES = ("app/javascript/highlight.js",)

KIND_LABELS = {
    "controller": "Rails controller",
    "helper": "Rails helper",
    "job": "Rails job",
    "lib": "library code",
    "model": "Rails model",
    "serializer": "Rails serializer",
    "service": "Rails service object",
    "spec": "RSpec spec",
    "spec_feature": "RSpec feature spec",
    "spec_support": "RSpec support code (helper, factory, harness)",
    "view": "ERB template",
    "javascript": "JavaScript",
}

RAILS_KINDS = {
    "controller", "helper", "job", "model", "serializer", "service",
}
RUBY_KINDS = RAILS_KINDS | {"lib", "spec", "spec_feature", "spec_support"}
APP_KINDS = RAILS_KINDS | {"lib"}
TEST_KINDS = {"spec", "spec_feature"}
ANY_KINDS = RUBY_KINDS | {"javascript", "view"}

FORM_RE = re.compile(r"form_with|form_context|simple_form|<form")
FACTORY_RE = re.compile(r"(?:create|build|attributes_for)\(:")


# ---------------------------------------------------------------------------
# Discovery: targets (files or dirs) -> gradable files with a kind
# ---------------------------------------------------------------------------


def classify(rel_path):
    """Map a repo-relative path to a file kind, or None if not gradable.

    Only the app, spec and lib trees carry house coding rules worth grading:
    config, migrations, seeds data and vendored assets do not.
    """
    if rel_path.startswith(SKIP_PATH_PREFIXES):
        return None
    if not rel_path.endswith(GRADABLE_EXTS):
        return None
    if rel_path.endswith(".min.js") or rel_path in VENDORED_FILES:
        return None
    if rel_path.startswith("app/views/"):
        return "view"
    if rel_path.startswith("app/javascript/"):
        return "javascript"
    if rel_path.startswith("spec/"):
        if rel_path.startswith("spec/features/"):
            return "spec_feature"
        support = ("spec/support/", "spec/factories/", "spec/fixtures/")
        if rel_path.startswith(support):
            return "spec_support"
        if rel_path in ("spec/rails_helper.rb", "spec/spec_helper.rb"):
            return "spec_support"
        return "spec"
    for prefix, kind in (
        ("app/models/", "model"),
        ("app/controllers/", "controller"),
        ("app/services/", "service"),
        ("app/helpers/", "helper"),
        ("app/jobs/", "job"),
        ("app/serializers/", "serializer"),
    ):
        if rel_path.startswith(prefix):
            return kind
    if rel_path.startswith("lib/"):
        return "lib"
    return None


def discover(targets, kinds=None):
    """Expand file and dir targets into (abs_path, rel_path, kind) triples."""
    found = []
    for target in targets:
        path = target if os.path.isabs(target) else os.path.join(REPO_ROOT, target)
        if os.path.isfile(path):
            candidates = [path]
        elif os.path.isdir(path):
            candidates = []
            for root, dirs, files in os.walk(path):
                dirs[:] = [d for d in dirs if d not in SKIP_DIR_NAMES]
                candidates.extend(os.path.join(root, f) for f in files)
        else:
            print(f"no such file or directory: {target}", file=sys.stderr)
            continue
        for candidate in candidates:
            rel = os.path.relpath(candidate, REPO_ROOT)
            kind = classify(rel)
            if kind and (not kinds or kind in kinds):
                found.append((candidate, rel, kind))
    return sorted(set(found))


def read_source(abs_path):
    """Read a file for grading. Returns (source, truncated)."""
    with open(abs_path, encoding="utf-8", errors="replace") as f:
        text = f.read()
    if len(text) <= MAX_SOURCE_CHARS:
        return text, False
    return text[:MAX_SOURCE_CHARS], True


# ---------------------------------------------------------------------------
# The rubric
#
# engine "jev" -> the question is sent to Jev (one call per file, all
# questions together) and the answer is graded against the thresholds below.
#
# For noul checks the probability is the goodness, unless invert is set: then
# the question asks for a *bad* thing and a low probability is good.
# score checks grade a 0..N level against score_pass / score_warn.
# ---------------------------------------------------------------------------

