# ---------------------------------------------------------------------------
# Jev client
# ---------------------------------------------------------------------------


def load_api_key():
    """OPENCODE_API_KEY, then /run/secrets/opencode_api_key, then .env."""
    key = os.environ.get("OPENCODE_API_KEY")
    if key:
        return key.strip()
    try:
        with open(DEFAULT_KEY_FILE) as f:
            return f.read().strip()
    except OSError:
        pass
    env_path = os.path.join(REPO_ROOT, ".env")
    try:
        with open(env_path) as f:
            for line in f:
                name, sep, value = line.partition("=")
                if sep and name.strip() == "OPENCODE_API_KEY":
                    return value.strip().strip("'\"")
    except OSError:
        pass
    return None


def call_jev(state, questions, model, api_key, session_id):
    payload = {"model": model, "state": state, "questions": questions}
    req = urllib.request.Request(
        ZEN_SYSTEMONE_URL,
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {api_key}",
            "Content-Type": "application/json",
            "User-Agent": "grade-code/0.1 (play-test)",
            "x-opencode-session": session_id,
        },
        method="POST",
    )
    last_err = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=180) as r:
                return json.loads(r.read().decode()), None
        except urllib.error.HTTPError as e:
            body = e.read().decode()[:400]
            last_err = f"HTTP {e.code}: {body}"
            if e.code == 429:
                if "FreeUsageLimitError" in body:
                    # free-tier quota exhausted - retrying will not help, and
                    # the backoff would stall the whole sweep
                    break
                time.sleep(5 * (attempt + 1))
                continue
            if e.code in (402, 401, 400):  # will not fix on retry
                break
        except Exception as e:  # noqa: BLE001
            last_err = f"{type(e).__name__}: {e}"
        time.sleep(1 + attempt)
    return None, last_err


# ---------------------------------------------------------------------------
# Grading
# ---------------------------------------------------------------------------


def active_checks(kind, source):
    out = []
    for c in CHECKS:
        if kind not in c["types"]:
            continue
        pattern = c.get("requires_source")
        if pattern and not pattern.search(source):
            continue
        out.append(c)
    return out


def build_jev_state(rel_path, kind, source, truncated):
    return {
        "file": {
            "path": rel_path,
            "kind": kind,
            "kind_label": KIND_LABELS.get(kind, kind),
            "lines": source.count("\n") + 1,
            "truncated": truncated,
        },
        "source": source,
    }


def grade_jev_answers(answers, meta):
    results = OrderedDict()
    for cid, c in meta.items():
        ans = answers.get(cid)
        if ans is None:
            continue
        entry = {
            "label": c["label"],
            "engine": "jev",
            "weight": c["weight"],
            "raw": ans,
        }
        if ans["type"] == "noul":
            p = ans["noul"]
            good = (1.0 - p) if c.get("invert") else p
            entry["value"] = p
            entry["goodness"] = good
            thr = c.get("threshold", 0.5)
            if good >= thr:
                entry["status"] = "PASS"
            elif good >= thr - 0.3:
                entry["status"] = "WARN"
            else:
                entry["status"] = "FAIL"
            entry["note"] = f"noul={p:.2f}" + (" (inverted)" if c.get("invert") else "")
        elif ans["type"] == "score":
            s = ans["score"]
            levels = len(ans["legend"])
            good = 1.0 if s >= c["score_pass"] else (0.5 if s >= c["score_warn"] else 0.0)
            entry["value"] = s
            entry["goodness"] = good
            entry["status"] = "PASS" if good == 1.0 else ("WARN" if good == 0.5 else "FAIL")
            entry["note"] = f"score={s:.2f}/{levels - 1} (conf {ans.get('confidence', 0):.2f})"
        elif ans["type"] == "choice":
            entry["value"] = ans["choice"]
            entry["goodness"] = 1.0 if ans["choice"] in c.get("pass_choices", ()) else 0.0
            entry["status"] = "PASS" if entry["goodness"] else "FAIL"
            entry["note"] = f"choice={ans['choice']} (conf {ans.get('confidence', 0):.2f})"
        else:
            continue
        # a hard FAIL the model is not confident about is a review flag, not a
        # verdict (TypeSafe confidence architecture: act only when confident)
        conf = ans.get("confidence")
        if conf is not None and conf < 0.3 and entry["status"] == "FAIL":
            entry["status"] = "WARN"
            entry["goodness"] = 0.5
            entry["note"] += " [low confidence - human review]"
        results[cid] = entry
    return results


def summarise(results):
    counted = {k: v for k, v in results.items() if v["status"] != "SKIP"}
    total_w = sum(r["weight"] for r in counted.values())
    got_w = sum(r["weight"] * r["goodness"] for r in counted.values())
    score = round(100 * got_w / total_w) if total_w else 0
    letter = "A" if score >= 90 else "B" if score >= 75 else "C" if score >= 60 else "D" if score >= 45 else "F"
    counts = {s: sum(1 for r in counted.values() if r["status"] == s) for s in ("PASS", "WARN", "FAIL")}
    return score, letter, counts


def build_jev_questions(checks):
    questions = {}
    meta = {}
    for c in checks:
        questions[c["id"]] = json.loads(json.dumps(c["question"]))
        meta[c["id"]] = c
    return questions, meta


def print_report(x, results, score, letter, counts, jev_info):
    print(f"Code grader - {x['path']}")
    truncated = " (source truncated)" if x.get("truncated") else ""
    print(f"kind: {x['kind']} ({KIND_LABELS.get(x['kind'], x['kind'])}) | "
          f"lines: {x['lines']} | checks: {len(results)}{truncated}")
    print()
    for r in results.values():
        mark = {"PASS": "+", "WARN": "~", "FAIL": "X", "SKIP": "-"}[r["status"]]
        print(f"  [{mark}] {r['status']:<4} {r['label']:<44} "
              f"({r['engine']:<4} w{r['weight']}) {r['note']}")
    print()
    print(f"Score: {score}/100 ({letter}) - {counts['PASS']} pass, "
          f"{counts['WARN']} warn, {counts['FAIL']} fail")
    if jev_info:
        print(f"Jev: model={jev_info['model']}, {jev_info['input_tokens']} in / "
              f"{jev_info['output_tokens']} out tokens, {jev_info['seconds']:.2f}s")


# ---------------------------------------------------------------------------
# One file at a time
# ---------------------------------------------------------------------------


def grade_file(abs_path, rel_path, kind, args, api_key):
    """Grade one file. Returns a result dict; never raises."""
    t_start = time.time()
    try:
        source, truncated = read_source(abs_path)
        x = {
            "path": rel_path,
            "kind": kind,
            "lines": source.count("\n") + 1,
            "truncated": truncated,
        }
        checks = active_checks(kind, source)
        if not checks:
            return dict(x, score=None, letter="-",
                        counts={"PASS": 0, "WARN": 0, "FAIL": 0}, checks={},
                        jev=None, jev_error=None,
                        skipped=f"no checks apply to kind '{kind}'",
                        seconds=round(time.time() - t_start, 2))
        if not api_key:
            return dict(x, score=None, letter="-",
                        counts={"PASS": 0, "WARN": 0, "FAIL": 0}, checks={},
                        jev=None, jev_error="no API key",
                        skipped="no Jev API key", seconds=round(time.time() - t_start, 2))

        questions, meta = build_jev_questions(checks)
        state = build_jev_state(rel_path, kind, source, truncated)
        t_jev = time.time()
        slug = re.sub(r"[^a-z0-9]", "", rel_path)[-40:]
        resp, err = call_jev(state, questions, args.model, api_key, f"grade-code-{slug}")
        if err:
            return dict(x, score=None, letter="-",
                        counts={"PASS": 0, "WARN": 0, "FAIL": 0}, checks={},
                        jev=None, jev_error=err, skipped=err,
                        seconds=round(time.time() - t_start, 2))
        jev_info = {
            "model": resp.get("model", args.model),
            "input_tokens": resp.get("usage", {}).get("input_tokens"),
            "output_tokens": resp.get("usage", {}).get("output_tokens"),
            "seconds": round(time.time() - t_jev, 2),
        }
        results = grade_jev_answers(resp.get("answers", {}), meta)
        score, letter, counts = summarise(results)
        return dict(x, score=score, letter=letter, counts=counts, checks=results,
                    jev=jev_info, jev_error=None, seconds=round(time.time() - t_start, 2))
    except Exception as e:  # noqa: BLE001
        return {"path": rel_path, "kind": kind, "score": None, "letter": "E",
                "counts": {"PASS": 0, "WARN": 0, "FAIL": 0}, "checks": {},
                "jev": None, "jev_error": None,
                "error": f"{type(e).__name__}: {e}",
                "seconds": round(time.time() - t_start, 2)}


# ---------------------------------------------------------------------------
# Batch mode
# ---------------------------------------------------------------------------


def run_batch(targets, args, api_key):
    t0 = time.time()
    rows = []
    done = 0
    with ThreadPoolExecutor(max_workers=args.workers) as pool:
        futs = {
            pool.submit(grade_file, abs_path, rel_path, kind, args, api_key): rel_path
            for abs_path, rel_path, kind in targets
        }
        for fut in as_completed(futs):
            row = fut.result()
            done += 1
            rows.append(row)
            if row["score"] is None:
                why = row.get("error") or row.get("skipped") or ""
                print(f"[{done}/{len(targets)}] SKIP {row['path']} - {why[:80]}", file=sys.stderr)
            else:
                fails = ",".join(cid for cid, r in row["checks"].items() if r["status"] == "FAIL") or "-"
                print(f"[{done}/{len(targets)}] {row['score']:>3} {row['letter']} "
                      f"{row['kind']:<13} {fails[:50]} {row['path']}", file=sys.stderr)

    rows.sort(key=lambda r: (r["score"] is None, r["score"] if r["score"] is not None else 0))
    graded = [r for r in rows if r["score"] is not None]
    errors = [r for r in rows if r["score"] is None]

    if args.json:
        print(json.dumps(rows, indent=2))
    else:
        print(f"\nCode grader - batch of {len(rows)} (workers={args.workers}, model={args.model})")
        print(f"{'Score':>5} {'L':<2} {'Kind':<13} {'p/w/x':<9} {'Lines':>5}  Failed checks")
        print("-" * 110)
        for r in rows:
            if r["score"] is None:
                why = r.get("error") or r.get("skipped") or ""
                print(f"{'---':>5} {'-':<2} {r['kind']:<13} {'':<9} {r.get('lines', 0):>5}  "
                      f"{r['path']} - {why[:60]}")
                continue
            c = r["counts"]
            fails = ",".join(cid for cid, chk in r["checks"].items() if chk["status"] == "FAIL")
            print(f"{r['score']:>5} {r['letter']:<2} {r['kind']:<13} "
                  f"{c['PASS']}/{c['WARN']}/{c['FAIL']:<5} {r['lines']:>5}  {fails or '-'} {r['path']}")

        if graded:
            scores = sorted(r["score"] for r in graded)
            median = scores[len(scores) // 2]
            letters = Counter(r["letter"] for r in graded)
            kinds = Counter(r["kind"] for r in graded)
            wall = time.time() - t0
            print("-" * 110)
            print(f"{len(graded)} graded, {len(errors)} errored | median {median} | "
                  f"{' '.join(f'{l}:{n}' for l, n in sorted(letters.items()))} | "
                  f"{' '.join(f'{k}:{n}' for k, n in sorted(kinds.items()))} | "
                  f"{wall:.0f}s total, {wall / max(len(rows), 1):.1f}s/file")
            fail_counter = Counter()
            warn_counter = Counter()
            for r in graded:
                for cid, chk in r["checks"].items():
                    if chk["status"] == "FAIL":
                        fail_counter[chk["label"]] += 1
                    elif chk["status"] == "WARN":
                        warn_counter[chk["label"]] += 1
            if fail_counter:
                print("\nMost-failed checks across the batch:")
                for label, n in fail_counter.most_common(10):
                    print(f"  FAIL x{n:<4} {label}")
            if warn_counter:
                print("\nMost-warned checks across the batch:")
                for label, n in warn_counter.most_common(5):
                    print(f"  WARN x{n:<4} {label}")

    if args.csv:
        with open(args.csv, "w", newline="") as f:
            w = csv.writer(f)
            w.writerow(["score", "letter", "kind", "lines", "path", "pass", "warn", "fail",
                        "failed_checks", "jev_error", "error"])
            for r in rows:
                w.writerow([
                    r["score"] if r["score"] is not None else "",
                    r["letter"], r["kind"], r.get("lines", ""), r["path"],
                    r["counts"]["PASS"], r["counts"]["WARN"], r["counts"]["FAIL"],
                    ";".join(cid for cid, chk in r["checks"].items() if chk["status"] == "FAIL"),
                    r.get("jev_error") or "",
                    r.get("error") or "",
                ])
        print(f"\nCSV written to {args.csv}", file=sys.stderr)
    return 0


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------


def main():
    parser = argparse.ArgumentParser(
        description="Grade this repo's source and spec files against the house "
                    "coding rules using Jev.",
        epilog="Batch mode (2+ files) prints a worst-first ranked table; a "
               "single file prints the full per-check report.",
    )
    parser.add_argument("targets", nargs="*",
                        help=f"files or dirs to grade (default: {' '.join(DEFAULT_TARGETS)})")
    parser.add_argument("--kinds", help="comma-separated kinds to keep: "
                        + ",".join(sorted(KIND_LABELS)))
    parser.add_argument("--limit", type=int, help="grade at most N discovered files")
    parser.add_argument("--workers", type=int, default=1,
                        help="parallel batch workers (default 1 - one file at a time)")
    parser.add_argument("--csv", help="write batch results to a CSV file")
    parser.add_argument("--model", default=DEFAULT_MODEL, help=f"Jev model id (default {DEFAULT_MODEL})")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--list-checks", action="store_true", help="print the rubric and exit")
    args = parser.parse_args()

    if args.list_checks:
        for c in CHECKS:
            kinds = ",".join(sorted(c["types"]))
            print(f"{c['id']:<26} w{c['weight']:<3} [{kinds}]\n"
                  f"{'':<26}    {c['label']}")
        return 0

    kinds = set(args.kinds.split(",")) if args.kinds else None
    if kinds and kinds - set(KIND_LABELS):
        parser.error(f"unknown kind(s): {', '.join(sorted(kinds - set(KIND_LABELS)))}")

    targets = discover(args.targets or DEFAULT_TARGETS, kinds)
    if not targets:
        print(f"no gradable files in: {', '.join(args.targets or DEFAULT_TARGETS)}", file=sys.stderr)
        return 2
    if args.limit:
        targets = targets[: args.limit]

    api_key = load_api_key()

    if len(targets) == 1 and not args.json and not args.csv:
        abs_path, rel_path, kind = targets[0]
        result = grade_file(abs_path, rel_path, kind, args, api_key)
        if result["score"] is None:
            print(f"ERROR grading {rel_path}: {result.get('error') or result.get('skipped')}",
                  file=sys.stderr)
            return 2
        print_report(result, result["checks"], result["score"], result["letter"],
                     result["counts"], result["jev"])
        if result.get("jev_error"):
            print(f"note: Jev unavailable ({result['jev_error']})", file=sys.stderr)
        return 0

    return run_batch(targets, args, api_key)


if __name__ == "__main__":
    sys.exit(main())
